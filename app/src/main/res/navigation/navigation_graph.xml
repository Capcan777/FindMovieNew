<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_graph"
    app:startDestination="@id/moviesFragment">

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.findmovienew.ui.details.DetailsFragment"
        android:label="DetailsFragment" >
        <action
            android:id="@+id/action_detailsFragment_to_moviesCastFragment"
            app:destination="@id/moviesCastFragment" />
    </fragment>
    <fragment
        android:id="@+id/moviesFragment"
        android:name="com.example.findmovienew.ui.movies.MoviesFragment"
        android:label="MoviesFragment" >
        <action
            android:id="@+id/action_moviesFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/moviesCastFragment"
        android:name="com.example.findmovienew.ui.cast.MoviesCastFragment"
        android:label="MoviesCastFragment" />
    <fragment
        android:id="@+id/namesFragment"
        android:name="com.example.findmovienew.ui.names.NamesFragment"
        android:label="fragment_names"
        tools:layout="@layout/fragment_names" />
    <fragment
        android:id="@+id/infoFragment"
        android:name="com.example.findmovienew.ui.info.InfoFragment"
        android:label="fragment_info"
        tools:layout="@layout/fragment_info" />
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.findmovienew.ui.history.HistoryFragment"
        android:label="history_fragment"
        tools:layout="@layout/fragment_history"/>
</navigation>